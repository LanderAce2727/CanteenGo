# Local development defaults to SQLite when DATABASE_URL is absent.
CANTEENGO_DB=data/canteengo.sqlite3
# Cloud: set DATABASE_URL privately in Render (never commit the real value).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL overrides CANTEENGO_DB for both the server and account CLI.
# Run PostgreSQL integration tests only against a dedicated test database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require
